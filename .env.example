# Copia questo file in `.env` e compila i valori. NON committare `.env`.

# --- Firebase (configurazione web, dal pannello del progetto Firebase) ---
# Nota: la config web di Firebase non è un segreto, ma la teniamo qui per pulizia.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Provider quotazioni ---
# API key Finnhub (free tier). Verrà inclusa nel bundle client:
# per un'app personale è accettabile, ma tienila comunque fuori dal repo.
FINNHUB_API_KEY=

# API key Alpha Vantage (gratuita, https://www.alphavantage.co/support/#api-key) per i
# mercati NON-USA (Euronext Amsterdam, Londra, ecc.). Dati EOD, 25 richieste/giorno.
ALPHAVANTAGE_API_KEY=

# --- Opzionale: fonte FX ---
# Frankfurter (BCE) non richiede chiave. Se in futuro usi un provider con chiave, aggiungila qui.
# FX_API_KEY=

# --- Solo per l'import una-tantum dello storico su Firestore (npm run import:seed) ---
# Credenziali dell'utente creato in Firebase Authentication. Restano in locale (.env è gitignorato).
SEED_EMAIL=
SEED_PASSWORD=
